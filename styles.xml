<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#101827</item>
        <item name="android:navigationBarColor">#101827</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#52E0C4</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="PrimaryButton">
        <item name="android:backgroundTint">#52E0C4</item>
        <item name="android:textColor">#101827</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">10dp</item>
    </style>
    <style name="SecondaryButton">
        <item name="android:backgroundTint">#27364B</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
