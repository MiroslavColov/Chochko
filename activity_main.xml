<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#101827" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="CROMA / STEERING" android:textSize="13sp" android:letterSpacing="0.2"
            android:textColor="#52E0C4"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Pump diagnostics" android:textStyle="bold" android:textSize="30sp"
            android:layout_marginTop="7dp" android:textColor="#FFFFFF"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Fiat Croma (194) • 1.9 Multijet 120 hp • TRW electrohydraulic steering"
            android:layout_marginTop="6dp" android:textColor="#B5C3D5" android:textSize="14sp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:orientation="vertical" android:padding="15dp"
            android:background="@drawable/card">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Required hardware" android:textColor="#FFFFFF" android:textSize="17sp"
                android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="7dp" android:textSize="14sp" android:textColor="#C4D1E0"
                android:text="Bluetooth Classic ELM327 + MultiECUScan GREEN A1 adapter (diagnostic K-line on car OBD pin 12). Pair the ELM327 in Android Bluetooth settings first." />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="14dp" android:padding="15dp"
            android:background="@drawable/card">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Connection" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/connectionStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="Not connected" android:textColor="#F7BC67" android:textSize="14sp"/>
            <Spinner android:id="@+id/deviceSpinner" android:layout_width="match_parent"
                android:layout_height="50dp" android:layout_marginTop="5dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/refreshButton" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    style="@style/SecondaryButton" android:text="Refresh paired"/>
                <Button android:id="@+id/connectButton" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    style="@style/PrimaryButton" android:text="Connect"/>
                <Button android:id="@+id/disconnectButton" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    style="@style/SecondaryButton" android:text="Close"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="14dp" android:padding="15dp"
            android:background="@drawable/card">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Tests" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/batteryVoltage" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="Vehicle voltage: —" android:textColor="#52E0C4" android:textSize="21sp"/>
            <Button android:id="@+id/adapterTestButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" style="@style/SecondaryButton"
                android:text="Test ELM327 adapter"/>
            <Button android:id="@+id/voltageButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" style="@style/SecondaryButton"
                android:text="Read OBD voltage"/>
            <Button android:id="@+id/klineButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" style="@style/SecondaryButton"
                android:text="Experimental steering K-line probe"/>
            <TextView android:id="@+id/pumpStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="Pump ECU: not verified" android:textSize="13sp" android:textColor="#F7BC67"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:textColor="#B5C3D5" android:textSize="12sp"
                android:text="Experimental: targets an UNVERIFIED KWP2000 address and sends read-oriented handshake/identification frames only. A failure or NO DATA does NOT prove the pump is faulty. No fault clearing, programming or actuator commands." />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="14dp" android:padding="15dp"
            android:background="@drawable/card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="Diagnostic log" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" />
                <Button android:id="@+id/copyButton" style="@style/SecondaryButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Copy log" />
            </LinearLayout>
            <ScrollView android:layout_width="match_parent" android:layout_height="270dp"
                android:fillViewport="true">
                <TextView android:id="@+id/logText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="#CFDBE9" android:textSize="12sp"
                    android:fontFamily="monospace" android:padding="8dp" android:textIsSelectable="true"/>
            </ScrollView>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:layout_marginBottom="24dp"
            android:text="PARKED VEHICLE ONLY • If power steering is not working, do not rely on this app to declare the car safe to drive. Hardware diagnosis is still required."
            android:textColor="#F7BC67" android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>
